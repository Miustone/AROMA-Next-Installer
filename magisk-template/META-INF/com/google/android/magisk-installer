#!/sbin/sh
# AROMA-Next Magisk / KernelSU / APatch Module Installer Bridge
# Supports:
#   1) Standard Magisk / KernelSU / APatch App & Recovery via util_functions.sh
#   2) Standalone TWRP/OrangeFox fallback (installs directly to /data/adb/modules/<id>)
#      for KernelSU / APatch users when /data/adb/magisk/util_functions.sh is absent.

OUTFD="$2"
ZIPFILE="$3"

ui_print() {
  if [ -n "$OUTFD" ] && [ -e "/proc/self/fd/$OUTFD" ]; then
    echo "ui_print $1" >&"$OUTFD"
    echo "ui_print" >&"$OUTFD"
  else
    echo "$1"
  fi
}

if [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
  install_module
  exit $?
fi

# Standalone Recovery Fallback (works with KernelSU / APatch / decrypted /data in TWRP)
ui_print "- Using standalone AROMA-Next module installer (KernelSU/APatch/Recovery)..."

WORK="/tmp/aroma-mod-work"
rm -rf "$WORK"
mkdir -p "$WORK"
unzip -o "$ZIPFILE" -d "$WORK" >/dev/null 2>&1 || {
  ui_print "! Failed to unpack archive $ZIPFILE"
  exit 1
}

if [ ! -f "$WORK/module.prop" ]; then
  ui_print "! Missing module.prop in archive."
  exit 1
fi

MODID="$(grep -E '^id=' "$WORK/module.prop" | head -n1 | cut -d'=' -f2- | tr -d '\r')"
if [ -z "$MODID" ]; then
  ui_print "! Invalid module.prop (missing id=)."
  exit 1
fi

# Ensure /data is mounted in recovery
if ! grep -q " /data " /proc/mounts 2>/dev/null; then
  mount /data 2>/dev/null || true
fi

if [ ! -d /data/adb/modules ]; then
  if [ -d /data/adb ]; then
    mkdir -p /data/adb/modules
  else
    ui_print "! /data/adb not accessible (is /data encrypted in recovery?)."
    ui_print "! Flash this ZIP in the Magisk/KernelSU/APatch app or decrypt /data first."
    exit 1
  fi
fi

export MODPATH="/data/adb/modules/$MODID"
export TMPDIR="$WORK"
export ZIPFILE
export OUTFD
export BOOTMODE=false

rm -rf "$MODPATH"
mkdir -p "$MODPATH"
cp -f "$WORK/module.prop" "$MODPATH/module.prop"
[ -d "$WORK/system" ] && cp -af "$WORK/system" "$MODPATH/"

set_perm() {
  chown "$2:$3" "$1" 2>/dev/null || true
  chmod "$4" "$1" 2>/dev/null || true
}

set_perm_recursive() {
  find "$1" -type d 2>/dev/null | while read -r d; do
    chown "$2:$3" "$d" 2>/dev/null || true
    chmod "$4" "$d" 2>/dev/null || true
  done
  find "$1" -type f 2>/dev/null | while read -r f; do
    chown "$2:$3" "$f" 2>/dev/null || true
    chmod "$5" "$f" 2>/dev/null || true
  done
}

if [ -f "$WORK/customize.sh" ]; then
  . "$WORK/customize.sh"
fi

set_perm_recursive "$MODPATH" 0 0 0755 0644
ui_print "- Installed module '$MODID' to $MODPATH"
rm -rf "$WORK"
exit 0
