###
# AROMA-Next-Installer Module Configuration
###

ini_set("rom_name",    "AROMA-Next Module Template");
ini_set("rom_version", "26.11");
ini_set("rom_author",  "Miustone");
ini_set("rom_device",  "Universal arm64/arm32");

fontresload("0", "ttf/GoogleSans-Regular.ttf;ttf/Roboto-Regular.ttf;ttf/DroidSansFallback.ttf;", "12");
fontresload("1", "ttf/GoogleSans-Regular.ttf;ttf/Roboto-Regular.ttf;ttf/DroidSansFallback.ttf;", "14");

theme("blacknwhite");

# Probe Magisk / KernelSU / APatch / RO2RW capability at startup
ziptotmp("META-INF/com/google/android/aroma-env-check.sh", "envcheck.sh");
exec("/sbin/sh", "/tmp/aroma/envcheck.sh");

if prop("env.prop", "can_modify") != "1" then
  alert(
    "Environment Notice",
    "<b>No supported mod target found!</b>\n\n" +
    "- Magisk / KernelSU / APatch (/data/adb) missing or /data encrypted.\n" +
    "- System partitions are read-only (no RO2RW / SystemRW).\n\n" +
    "Running in Preview mode. Install Magisk/KernelSU/APatch, decrypt /data, or flash in the Magisk/KSU app to apply changes.",
    "@alert"
  );
  setvar("env_banner", "<b>Status:</b> <#selectbg_g>No Root Manager or RW Partition Detected (Preview Only)</#>\n\n");
else
  setvar("env_banner", "<b>Detected Target:</b> <#selectbg_g>" + prop("env.prop", "env_summary") + "</#>\n\n");
endif;

viewbox(
  "Welcome",
  "<b>" + ini_get("rom_name") + "</b> (" + ini_get("rom_version") + ")\n\n" +
  getvar("env_banner") +
  "Bring back classic Touch-GUI Android modding without breaking EROFS, Dynamic Partitions, or dm-verity.\n\n" +
  "<b>Systemless Mode (Default):</b> Generates a clean Magisk / KernelSU / APatch overlay module.\n" +
  "<b>Direct RW Mode (Optional):</b> Only for devices pre-converted with RO2RW / SystemRW and rebooted beforehand.",
  "@welcome"
);

selectbox(
  "Select Installation Mode",
  "Choose how modifications should be applied to your device:",
  "@install",
  "mode.prop",
  "Systemless Overlay Module (Recommended)",
    "Creates a Magisk / KernelSU / APatch module. Safe on EROFS, shared_blocks, Virtual A/B, and active dm-verity.", 1,
  "Direct Partition RW Mode (Advanced)",
    "Requires partitions pre-converted to RW via RO2RW or SystemRW + prior reboot. Falls back safely if still read-only.", 0
);

checkbox(
  "Customize Modifications",
  "Select which systemless (or RW) changes to apply:",
  "@personalize",
  "customize.prop",
  "System Tweaks (system.prop)", "", 2,
    "Smooth UI & Media Steps", "Sets ro.config.media_vol_steps=30 and disables error profiler", 1,
    "Skip Boot Sound",         "Sets ro.config.play.bootsound=0", 0,
  "Debloat Example (Systemless Mask / RW Delete)", "", 2,
    "Hide Demo Bloat App",     "Demonstrates safe .replace / whiteout masking of system apps", 0
);

ini_set("text_next", "Install Now");
ini_set("icon_next", "@installbutton");

viewbox(
  "Ready to Install",
  "Press <b>Install Now</b> to generate and install your customized module.",
  "@install"
);

ini_set("text_next", "Next");
ini_set("icon_next", "@next");

setvar("retstatus",
  install(
    "Installing Module",
    "Applying your selections safely...",
    "@install",
    "Installation completed (status: " + getvar("retstatus") + ")."
  )
);

ini_set("text_next", "Finish");
ini_set("icon_next", "@finish");

checkviewbox(
  "Finished",
  "<#selectbg_g><b>All Done!</b></#>\n\n" +
  "If you used Systemless Mode, the module is active on your next boot via Magisk / KernelSU / APatch.",
  "@welcome",
  "Reboot device now",
  "0",
  "reboot_it"
);

if getvar("reboot_it") == "1" then
  reboot("onfinish");
endif;
