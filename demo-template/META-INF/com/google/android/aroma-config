ini_set("rom_name",    "AROMA-Next Demo");
ini_set("rom_version", "26.11-RC5");
ini_set("rom_author",  "Miustone");
ini_set("rom_device",  "Universal arm64/arm32");
ini_set("rom_date",    "2026");

#-- Static HiDPI Splash + Classic AROMA Nostalgia Echo Animation
splash(1000, "sample");
anisplash(
    3,
    "splash/a1", 400,
    "splash/a2", 30,
    "splash/a3", 30,
    "splash/a4", 30,
    "splash/a5", 30,
    "splash/a6", 30
);

#-- Default Font (Google Sans) & Modern AMOLED Theme (native Monochrome White accent)
fontresload("0", "ttf/GoogleSans-Regular.ttf;ttf/Roboto-Regular.ttf;ttf/DroidSansFallback.ttf;", "12");
fontresload("1", "ttf/GoogleSans-Regular.ttf;ttf/Roboto-Regular.ttf;ttf/DroidSansFallback.ttf;", "14");
theme("amoled");

#-- Step 1: Welcome Showcase
viewbox(
    "AROMA-Next-Demo",
    "<@center><b>AROMA-Next-Installer (ANI)</b>\n" +
    "64-bit DRM/KMS NextGen Engine  •  V26.11 RC5</@>\n\n" +
    "<b>What's New in RC5:</b>\n\n" +
    "• <b>AMOLED Modern & Material 3 You</b>\n" +
    "  Pure OLED black, rounded cards, slim top status bar & redesigned icons.\n\n" +
    "• <b>1-Tap Live Appearance Hub</b>\n" +
    "  Open the 3-dot menu -> <b>Appearance</b> to preview Themes, Accents, Fonts & Transitions live.\n\n" +
    "• <b>Interactive slider(...) & Lossless PNG Screenshots</b>\n" +
    "  Press Vol-Down + Power anytime for ~250 KB lossless PNG screenshots.\n\n" +
    "<@center><i>Tap Next to explore every feature step by step.</i></@>",
    "@welcome"
);

#-- Step 2: Interactive Demo Menu
menubox(
    "Demo Hub",
    "Choose the full guided tour or jump straight to a specific feature:",
    "@apps",
    "demo_hub.prop",
    "Full Guided Showcase",        "Explore Themes, Accents, Slider, Fonts, Controls & Install", "@install",
    "Open AROMA-Next-Filemanager", "Bootloop-Saver, ZIP Inspector, Quick Reboot & Diagnostics",  "@default",
    "Changelog (V26.11)",          "Read the modern AROMA-Next-Installer changelog",              "@update",
    "Apache 2.0 License",          "View the open-source license & bundled fonts",                "@license"
);

if prop("demo_hub.prop", "selected") == "2" then
    filemanager();
endif;

if prop("demo_hub.prop", "selected") == "3" then
    textbox("Changelog", "AROMA-Next-Installer V26.11 Release Notes", "@update", resread("changelog.txt"));
endif;

if prop("demo_hub.prop", "selected") == "4" then
    textbox("Open-Source License", "Apache License 2.0 & Font Licenses", "@license", resread("license.txt"));
endif;

#-- Step 3: Live Theme Showcase (stays open — tap any theme to preview instantly, tap Next when done!)
live_appearance(
    "theme",
    "Theme Showcase (Live)",
    "Scroll and tap any theme to preview it LIVE right here — tap Next when you're happy:",
    "@personalize"
);

#-- Step 4: Live Accent Color Showcase (stays open — tap any accent to preview instantly!)
live_appearance(
    "accent",
    "Live Accent Color",
    "Tap any Material You accent color to apply it LIVE across buttons, sliders & highlights:",
    "@personalize"
);

#-- Step 5: NEW Interactive Slider Control Showcase!
slider(
    "Slider Control Showcase",
    "Drag the slider or tap - / + to tune an example ZRAM swap size (works with Volume Keys in BOOTMODE=1 too!):",
    "@customize",
    "tuning.prop",
    "zram_mb",
    "512",
    "8192",
    "512",
    "4096",
    "MB"
);

#-- Step 6: Live Modern Font Showcase (7 bundled OFL fonts — tap to preview live!)
live_appearance(
    "font",
    "Font Showcase (Live)",
    "Tap any bundled SIL OFL font to preview typography LIVE right here:",
    "@personalize"
);

#-- Step 7: Live Transition Showcase (5 smooth 60-120Hz VSYNC transitions)
live_appearance(
    "transition",
    "Transition Showcase (Live)",
    "Tap any 60-120Hz VSYNC window transition style (you can also switch anytime via 3-dot -> Appearance):",
    "@personalize"
);

#-- Step 8: UTF-8 Multilanguage Showcase
include("language_select.edify");

viewbox(
    "UTF-8 & Multilanguage Test",
    "FreeType 2.15.0 + RFC 3629 minutf8 rendering test:\n\n" +
    "• English / Deutsch: ÄÖÜ äöüß — Butterweiche 120Hz Animationen!\n" +
    "• Français / Español: Éàèùç ñ ¿¡\n" +
    "• Русский: Добро пожаловать в AROMA-Next\n" +
    "• 日本語 / 中文: インストーラへようこそ / 欢迎使用\n" +
    "• עברית: ברוכים הבאים להתקנה\n\n" +
    "<b>Active Mode:</b> " + iif(is_volkey() == "1", "Volume Key (BOOTMODE=1)", "Touch GUI (BOOTMODE=0)") +
    "  •  <b>Selected ZRAM:</b> " + prop("tuning.prop", "zram_mb") + " MB",
    "@info"
);

loadlang("langs/en.lang");

#-- Step 9: Grouped Checkbox Showcase
checkbox(
    "Checkbox Control Showcase",
    "Select any combination of example components:",
    "@apps",
    "checkbox_demo.prop",
    "Core Features",      "",                                                 2,
    "64-bit DRM Engine",  "Direct backbuffer NEON blitting (60-120Hz)",       1,
    "Filemanager Module", "Bootloop-Saver, ZIP Inspector & Diagnostics",      1,
    "Optional Extras",    "",                                                 2,
    "Extended Font Pack", "Google Sans, Inter, Outfit, Ubuntu, JetBrains",    1,
    "Material 3 Icons",   "Supersampled Material You tonal icons",            1
);

#-- Step 10: Mixed Form (Checkbox + Radio Group) Showcase
include("custombox_test.edify");

#-- Step 11: Interactive Confirm + Integrated Filemanager Trigger
if confirm(
    "Try AROMA-Next-Filemanager?",
    "Would you like to open the integrated <b>AROMA-Next-Filemanager</b> (Tools -> Bootloop-Saver, Quick Reboot, Diagnostics)?",
    "@info",
    "Open Filemanager",
    "Skip"
) == "yes" then
    filemanager();
endif;

#-- Step 12: Simulated Installation Progress
ini_set("text_next", "Run Demo Install");
viewbox(
    "Ready for Demo Install",
    "This runs the safe sample updater-script (no system files are modified).\n\n" +
    "• <b>ZRAM Slider Value:</b> " + prop("tuning.prop", "zram_mb") + " MB\n" +
    "• <b>Theme / Accent:</b> " + ini_get("theme") + " / " + ini_get("accent") + "\n\n" +
    "Press <b>Run Demo Install</b> to test the progress bar and live log view.",
    "@install"
);

ini_set("text_next", "Next >");
install(
    "Demo Installation",
    "Demonstrating progress bar & live log output...",
    "@install",
    "Demo installation completed safely."
);

ini_set("text_next", "Finish");
viewbox(
    "Demo Complete",
    "You have completed the <b>AROMA-Next-Installer V26.11 RC5</b> Full Feature Showcase!\n\n" +
    "Press <b>Finish</b> to return to Recovery.",
    "@confirm"
);
