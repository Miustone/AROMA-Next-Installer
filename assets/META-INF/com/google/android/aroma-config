ini_set("rom_name",    "AROMA-Next-Installer");
ini_set("rom_version", "26.11");
ini_set("rom_author",  "Miustone");
ini_set("rom_device",  "Universal arm64/arm32");
ini_set("rom_date",    "2026");

#-- Modern HiDPI Splash with classic AROMA nostalgia echo animation
anisplash(
    3,
    "splash/a1", 450,
    "splash/a2", 30,
    "splash/a3", 30,
    "splash/a4", 30,
    "splash/a5", 30,
    "splash/a6", 30
);

#-- Default Font (Google Sans) & Default Theme (Black & White)
fontresload("0", "ttf/GoogleSans-Regular.ttf;ttf/Roboto-Regular.ttf;ttf/DroidSansFallback.ttf;", "12");
fontresload("1", "ttf/GoogleSans-Regular.ttf;ttf/Roboto-Regular.ttf;ttf/DroidSansFallback.ttf;", "14");
theme("amoled");

#-- Step 1: Welcome
viewbox(
    "AROMA-Next-Installer",
    "Welcome to <b>AROMA-Next-Installer</b>\n" +
    "64-bit DRM/KMS NextGen Engine  •  V26.11\n\n\n" +
    "<b>What you can do right here:</b>\n\n" +
    "• <b>Live Themes & Fonts</b>\n" +
    "  Tap the 3-dot menu below anytime to switch Themes or any of the 7 bundled Fonts on the fly.\n\n" +
    "• <b>AROMA-Next-Filemanager</b>\n" +
    "  Manage Root Modules (/data/adb/modules), Internal Storage, and System Partitions directly from Recovery.\n\n" +
    "• <b>Clean Base Template</b>\n" +
    "  Customize aroma-config and updater-script to build your own modern flashable ROM, Kernel, or Mod.\n\n\n" +
    "<i>Tip: Flash AROMA-Next-Demo.zip if you want to explore the full interactive showcase of all controls.</i>",
    "@welcome"
);

#-- Step 2: Clean Example Options
selectbox(
    "Install Mode",
    "Choose what to do in this base installer template:",
    "@default",
    "install_mode.prop",
    "Standard Install",    "Run the sample installation script",                       1,
    "Open Filemanager",    "Launch integrated AROMA-Next-Filemanager & Module Manager", 0,
    "View Changelog",      "Read what is new in AROMA-Next-Installer V26.11",          0
);

if prop("install_mode.prop", "selected.0") == "2" then
    filemanager();
    exit("");
endif;

if prop("install_mode.prop", "selected.0") == "3" then
    textbox(
        "Changelog",
        "AROMA-Next-Installer Release Notes",
        "@update",
        resread("changelog.txt")
    );
endif;

#-- Step 3: Ready to Install
ini_set("text_next", "Install Now");
viewbox(
    "Ready to Install",
    "The installer is ready to run.\n\n" +
    "Press <b>Install Now</b> to continue, or <b>Back</b> to change your selection.",
    "@install"
);

ini_set("text_next", "Next >");

install(
    "Installing",
    "Running sample installation script...",
    "@install",
    "Installation finished cleanly."
);

ini_set("text_next", "Finish");
viewbox(
    "Completed",
    "<b>AROMA-Next-Installer</b> finished successfully.\n\n" +
    "Press <b>Finish</b> to return to Recovery.",
    "@info"
);
